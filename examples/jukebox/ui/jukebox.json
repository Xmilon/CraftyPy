{
  "id": "jukebox",
  "title": "♪ CraftPy Jukebox",
  "size": [
    460,
    530
  ],
  "root": {
    "type": "vbox",
    "padding": 8,
    "spacing": 6,
    "children": [
      {
        "type": "label",
        "text": "♪ Nothing playing",
        "style": "title",
        "bind": {
          "text": "track_title"
        }
      },
      {
        "type": "label",
        "text": "stopped · --:-- / --:--",
        "bind": {
          "text": "state_caption"
        }
      },
      {
        "type": "slider",
        "id": "position",
        "value": 0,
        "min": 0,
        "max": 1,
        "on_change": "jukebox_seek",
        "bind": {
          "value": "position",
          "max": "duration",
          "visible": "seek_visible"
        }
      },
      {
        "type": "progress",
        "value": 0,
        "max": 1,
        "bind": {
          "value": "position",
          "max": "duration",
          "visible": "progress_visible"
        }
      },
      {
        "type": "hbox",
        "spacing": 4,
        "children": [
          {
            "type": "button",
            "text": "⏮",
            "on_click": "jukebox_previous"
          },
          {
            "type": "button",
            "text": "▶ Play",
            "on_click": "jukebox_toggle",
            "bind": {
              "text": "toggle_label"
            }
          },
          {
            "type": "button",
            "text": "⏹",
            "on_click": "jukebox_stop"
          },
          {
            "type": "button",
            "text": "⏭",
            "on_click": "jukebox_next"
          },
          {
            "type": "button",
            "text": "⟳ Refresh",
            "on_click": "jukebox_refresh",
            "style": "text"
          }
        ]
      },
      {
        "type": "hbox",
        "spacing": 8,
        "children": [
          {
            "type": "label",
            "text": "Volume 80%",
            "bind": {
              "text": "volume_label"
            }
          },
          {
            "type": "slider",
            "id": "volume",
            "value": 80,
            "min": 0,
            "max": 100,
            "on_change": "jukebox_volume",
            "bind": {
              "value": "volume"
            }
          }
        ]
      },
      {
        "type": "hbox",
        "spacing": 8,
        "children": [
          {
            "type": "checkbox",
            "id": "loop",
            "label": "Loop",
            "checked": true,
            "on_change": "jukebox_loop",
            "bind": {
              "checked": "loop"
            }
          },
          {
            "type": "checkbox",
            "id": "shuffle",
            "label": "Shuffle",
            "checked": false,
            "on_change": "jukebox_shuffle",
            "bind": {
              "checked": "shuffle"
            }
          },
          {
            "type": "checkbox",
            "id": "nearby",
            "label": "Nearby players hear it",
            "checked": false,
            "on_change": "jukebox_nearby",
            "bind": {
              "checked": "nearby"
            }
          }
        ]
      },
      {
        "type": "hbox",
        "spacing": 8,
        "children": [
          {
            "type": "label",
            "text": "Melody instrument"
          },
          {
            "type": "dropdown",
            "id": "instrument",
            "options": [
              "harp"
            ],
            "selected": 0,
            "on_change": "jukebox_instrument",
            "bind": {
              "options": "instruments",
              "selected": "instrument"
            }
          }
        ]
      },
      {
        "type": "hbox",
        "spacing": 8,
        "children": [
          {
            "type": "label",
            "text": "Source"
          },
          {
            "type": "dropdown",
            "id": "source",
            "options": [
              "My music",
              "Packs",
              "Melodies"
            ],
            "selected": 0,
            "on_change": "jukebox_source",
            "bind": {
              "options": "sources",
              "selected": "source"
            }
          }
        ]
      },
      {
        "type": "list",
        "id": "tracks",
        "items": [],
        "selected": -1,
        "on_select": "jukebox_pick",
        "height": 160,
        "bind": {
          "items": "tracks",
          "selected": "selected_track",
          "enabled": "has_tracks"
        }
      },
      {
        "type": "label",
        "text": "Closing the window keeps the music playing.",
        "style": "hint",
        "bind": {
          "text": "message"
        }
      }
    ]
  },
  "preview_data": {
    "track_title": "♪ Foundry Waltz",
    "state_caption": "playing · 0:42 / 3:18",
    "position": 42,
    "duration": 198,
    "seek_visible": true,
    "progress_visible": false,
    "toggle_label": "⏸ Pause",
    "volume": 80,
    "volume_label": "Volume 80%",
    "loop": true,
    "shuffle": false,
    "nearby": false,
    "instruments": [
      "harp",
      "bell"
    ],
    "instrument": 0,
    "sources": [
      "My music",
      "Packs",
      "Melodies"
    ],
    "source": 0,
    "tracks": [
      "▶ Foundry Waltz",
      "   Skyward"
    ],
    "selected_track": 0,
    "has_tracks": true,
    "message": "Closing the window keeps the music playing."
  }
}
