{
  "id": "sky_status",
  "title": "☁ Expedition",
  "size": [
    360,
    290
  ],
  "root": {
    "type": "vbox",
    "padding": 8,
    "spacing": 8,
    "children": [
      {
        "type": "label",
        "text": "Expedition",
        "style": "title",
        "bind": {
          "text": "title"
        }
      },
      {
        "type": "label",
        "text": "Ready",
        "bind": {
          "text": "status"
        }
      },
      {
        "type": "progress",
        "value": 0,
        "max": 1,
        "bind": {
          "value": "found",
          "max": "total"
        }
      },
      {
        "type": "label",
        "text": "",
        "bind": {
          "text": "statistics"
        }
      },
      {
        "type": "label",
        "text": "",
        "style": "hint",
        "bind": {
          "text": "seed"
        }
      },
      {
        "type": "hbox",
        "spacing": 6,
        "children": [
          {
            "type": "button",
            "text": "Back to the hub",
            "on_click": "sky_hub",
            "bind": {
              "enabled": "can_return"
            }
          },
          {
            "type": "button",
            "text": "Go home",
            "on_click": "sky_home",
            "bind": {
              "enabled": "can_home"
            }
          }
        ]
      },
      {
        "type": "button",
        "text": "Take them down",
        "style": "text",
        "on_click": "sky_collapse",
        "bind": {
          "enabled": "can_collapse"
        }
      },
      {
        "type": "button",
        "text": "Close",
        "style": "text",
        "on_click": "close"
      }
    ]
  },
  "preview_data": {
    "title": "medium frost archipelago",
    "status": "Find the glowing Sky Crystals",
    "found": 3,
    "total": 8,
    "statistics": "Crystals 3 / 8 · time 2:41 · best 5:12",
    "seed": "seed 9217",
    "can_return": true,
    "can_home": true,
    "can_collapse": true
  }
}
