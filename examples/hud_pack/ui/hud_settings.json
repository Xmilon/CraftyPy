{
  "id": "hud_settings",
  "title": "HUD settings",
  "size": [
    320,
    260
  ],
  "preview_data": {
    "visible": true,
    "coords": true,
    "held": true,
    "toasts": true
  },
  "root": {
    "type": "vbox",
    "padding": 8,
    "spacing": 8,
    "children": [
      {
        "type": "label",
        "text": "What to show",
        "style": "title"
      },
      {
        "type": "checkbox",
        "id": "visible",
        "label": "Show HUD",
        "checked": true,
        "on_change": "hud_changed",
        "bind": {
          "checked": "visible"
        }
      },
      {
        "type": "checkbox",
        "id": "coords",
        "label": "Coordinates",
        "checked": true,
        "on_change": "hud_changed",
        "bind": {
          "checked": "coords"
        }
      },
      {
        "type": "checkbox",
        "id": "held",
        "label": "Held item",
        "checked": true,
        "on_change": "hud_changed",
        "bind": {
          "checked": "held"
        }
      },
      {
        "type": "checkbox",
        "id": "toasts",
        "label": "Welcome chat toasts",
        "checked": true,
        "on_change": "hud_changed",
        "bind": {
          "checked": "toasts"
        }
      },
      {
        "type": "label",
        "text": "Remap Toggle HUD and Open HUD settings in Controls or Module Keybinds.",
        "style": "hint"
      },
      {
        "type": "button",
        "text": "Close",
        "on_click": "close",
        "style": "text"
      }
    ]
  }
}
