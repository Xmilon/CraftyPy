{
  "id": "counter",
  "title": "Counter",
  "size": [
    300,
    210
  ],
  "preview_data": {
    "caption": "Clicked 6 times",
    "count": 6,
    "can_claim": false
  },
  "root": {
    "type": "vbox",
    "padding": 8,
    "spacing": 8,
    "children": [
      {
        "type": "label",
        "text": "Clicked 0 times",
        "style": "title",
        "bind": {
          "text": "caption"
        }
      },
      {
        "type": "progress",
        "value": 0,
        "max": 10,
        "bind": {
          "value": "count"
        }
      },
      {
        "type": "hbox",
        "spacing": 8,
        "children": [
          {
            "type": "button",
            "text": "-1",
            "on_click": "counter_less"
          },
          {
            "type": "button",
            "text": "+1",
            "on_click": "counter_more"
          },
          {
            "type": "button",
            "text": "Reward",
            "on_click": "counter_reward",
            "enabled": false,
            "bind": {
              "enabled": "can_claim"
            }
          }
        ]
      },
      {
        "type": "label",
        "text": "Your progress is saved for your next visit.",
        "style": "hint"
      },
      {
        "type": "button",
        "text": "Close",
        "on_click": "close",
        "style": "text"
      }
    ]
  }
}
