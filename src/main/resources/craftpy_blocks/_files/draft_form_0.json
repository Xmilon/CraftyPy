{
  "id": "{{name}}",
  "title": "Input draft form",
  "size": [
    340,
    230
  ],
  "preview_data": {
    "value": 3,
    "caption": "Example player",
    "options": [
      "One",
      "Two"
    ],
    "show": true,
    "enabled": true,
    "draft": "Saved example",
    "health": 14
  },
  "root": {
    "type": "vbox",
    "spacing": 8,
    "padding": 10,
    "children": [
      {
        "type": "label",
        "text": "Input draft form",
        "bind": {
          "text": "caption"
        }
      },
      {
        "type": "text_input",
        "id": "draft",
        "hint": "Draft survives refresh"
      },
      {
        "type": "button",
        "text": "Save / increment",
        "on_click": "{{name}}_apply"
      }
    ]
  }
}
